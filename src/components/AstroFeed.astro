---

---

<div class="bsky-container">
    
    <div class="search-box">
        <input
                type="text"
                id="bsky-input"
                placeholder="eg. bsky.app or did:plc:z72i7hdynmk6r22z27h6tvur"
                value=""
        />
        <button id="bsky-search-btn">Load Feed</button>
    </div>

    <!-- Status -->
    <div id="bsky-status" class="status-msg hidden"></div>

    <!-- Profile -->
    <div id="bsky-profile" class="profile-card hidden">
        <img id="bsky-avatar" src="" alt="Avatar" />
        <div class="profile-info">
            <h2 id="bsky-name"></h2>
            <p id="bsky-handle"></p>
            <p id="bsky-pds"></p>
            <p id="bsky-desc"></p>
            <div class="profile-subinfo">
                <p id="bsky-joined"></p>
                <p id="bsky-pronouns"></p>
                <p id="bsky-website"></p>
            </div>
        </div>
    </div>

    <!-- Tab-Navigation -->
    <div id="bsky-tabs-container" class="tabs hidden">
        <button id="bsky-btn-posts" class="tab-btn active">Posts</button>
        <button id="bsky-btn-likes" class="tab-btn">Likes</button>
    </div>

    <!-- Feeds -->
    <div id="bsky-feed-posts" class="feed hidden"></div>
    <div id="bsky-feed-likes" class="feed hidden"></div>
</div>

<script>
    import { Client, simpleFetchHandler } from '@atcute/client';
    
    // POST CONFIG DATA
    const POST_AMOUNT = 10;
    const LIKED_POST_AMOUNT = 10;

    const bskyClient = new Client({
        handler: simpleFetchHandler({ service: 'https://public.api.bsky.app' }),
    });
    
    // DOM ELEMENTS
    const input = document.getElementById('bsky-input') as HTMLInputElement;
    const searchBtn = document.getElementById('bsky-search-btn');
    const statusEl = document.getElementById('bsky-status');

    const profileEl = document.getElementById('bsky-profile');
    const avatarEl = document.getElementById('bsky-avatar') as HTMLImageElement;
    const nameEl = document.getElementById('bsky-name');
    const handleEl = document.getElementById('bsky-handle');
    const descEl = document.getElementById('bsky-desc');
    const pronounEl = document.getElementById('bsky-pronouns');
    const websiteEl = document.getElementById('bsky-website');
    const pdsEl = document.getElementById('bsky-pds');
    const joinedEl = document.getElementById('bsky-joined');

    const tabsContainer = document.getElementById('bsky-tabs-container');
    const btnPosts = document.getElementById('bsky-btn-posts');
    const btnLikes = document.getElementById('bsky-btn-likes');
    const feedPosts = document.getElementById('bsky-feed-posts');
    const feedLikes = document.getElementById('bsky-feed-likes');
    
    // default tab
    let currentTab = 'posts';

    function makeBlueskyWebLink(authorHandle: string, uri: string) {
        const postId = uri.split('/').pop();
        return `https://bsky.app/profile/${authorHandle}/post/${postId}`;
    }

    function formatTimestamp(isoString: string) {
        if (!isoString) return '';
        const date = new Date(isoString);
        return date.toLocaleDateString('en-US', {
            day: '2-digit',
            month: "short",
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        });
    }
    
    // CREATE POST ELEMENTS METHOD
    function createPostElement(post: any, prefix = "") : HTMLElement {
        const article = document.createElement("article");
        article.classList.add("post");

        if (prefix === "Liked") {
            article.classList.add("is-like");
        }

        const header = document.createElement("div");
        header.className = "post-header";

        const meta = document.createElement("div");
        meta.className = "meta";

        if (prefix) {
            meta.appendChild(document.createTextNode(`${prefix} `));
        }

        const authorName = document.createElement("span");
        authorName.className = "author-name";
        authorName.textContent = post.author.displayName || post.author.handle;

        meta.appendChild(authorName);
        meta.appendChild(document.createTextNode(` @${post.author.handle}`))
        header.appendChild(meta);

        const text = document.createElement("p");
        text.className = "post-text";
        text.textContent = post.record.text || "";
        
        // footer section
        const footer = document.createElement("div");
        footer.className = "post-footer";

        const time = document.createElement("div");
        time.className = "post-time";
        time.textContent = formatTimestamp(post.record.createdAt);

        const link = document.createElement("a");
        link.className = "bsky-link";
        link.href = makeBlueskyWebLink(post.author.handle, post.uri);
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = "Bluesky ↗";

        footer.appendChild(time);
        footer.appendChild(link);
        
        article.appendChild(header);
        article.appendChild(text);
        article.appendChild(footer);

        return article;
    }
    
    // MAIN METHOD
    async function loadBlueskyFeed() {
        const handle = input.value.trim();
        if (!handle) return;

        if (statusEl) {
            statusEl.classList.remove('hidden');
            statusEl.innerText = 'resolving user profile and pds...';
        }
        profileEl?.classList.add('hidden');
        tabsContainer?.classList.add('hidden');
        feedPosts?.classList.add('hidden');
        feedLikes?.classList.add('hidden');

        try {
            
            // get user profile
            const profileRes = await bskyClient.get('app.bsky.actor.getProfile', 
                { params: { actor: handle } });
            
            if(!profileRes.ok) throw new Error('User not found.');
            const profile= profileRes.data;
            
            // check if the user has a !no-unauthenticated label
            if(profile.labels)
            {
                const hasNoAuthLabel = profile.labels.some(
                    (label) => label.val === '!no-unauthenticated'
                );
                if(hasNoAuthLabel)
                    throw new Error('User has requested to hide from logged-out users.')
            }

            // using the did from the getProfile get the users plc entry
            const plcRes = await fetch(`https://plc.directory/${profile.did}`);
            if (!plcRes.ok) throw new Error('Failed to resolve user did.');
            const plcDoc = await plcRes.json();
            
            // get user pds
            const pdsService = plcDoc.service.find((s: any) => s.id === '#atproto_pds')?.serviceEndpoint;
            if (!pdsService) throw new Error('Failed to resolve user pds.');
            
            const pdsClient = new Client({
                handler: simpleFetchHandler({ service: pdsService }),
            });
            

            // update profile frontend
            if (avatarEl) avatarEl.src = profile.avatar || '/fop.png';
            if (nameEl) nameEl.textContent = profile.displayName || handle;
            if (handleEl) handleEl.textContent = `@${profile.handle}`;
            if (descEl) descEl.textContent = profile.description || '';
            if (pronounEl) pronounEl.textContent = profile.pronouns || '';
            if (websiteEl) websiteEl.textContent = profile.website || '';
            if (pdsEl) pdsEl.textContent = pdsService || '';
            if(profile.createdAt)
                if (joinedEl) joinedEl.textContent = formatTimestamp(profile.createdAt) || '';
            profileEl?.classList.remove('hidden');
            
            // load user posts via bluesky appview
            const feedRes = await bskyClient.get('app.bsky.feed.getAuthorFeed', {
                params: { actor: handle, filter: 'posts_and_author_threads', limit: POST_AMOUNT }
            });
            
            if(feedRes.ok)
            {
                if(feedPosts == null) return
                console.log(feedRes.data.feed[0]);
                feedPosts.replaceChildren();
                feedPosts.innerHTML = `<p class="empty-msg">${profile.displayName || handle} seems rather shy.</p>`;
                
                const userPosts: HTMLElement[] = feedRes.data.feed.map((item: any) => {
                    const isRepost =
                        item.reason?.$type === "app.bsky.feed.defs#reasonRepost";
                    return createPostElement(item.post, isRepost ? "Reposted" : "");
                });
                if(userPosts.length > 0)
                    feedPosts.replaceChildren(...userPosts);
            }
            
            // load likes via user repo
            const repoRes = await pdsClient.get('com.atproto.repo.listRecords', {
                params: { repo: profile.did, collection: 'app.bsky.feed.like', limit: LIKED_POST_AMOUNT }
            });
            if(repoRes.ok)
            {
                if(feedLikes == null) return
                feedLikes.replaceChildren();
                feedLikes.innerHTML = `<p class="empty-msg">${profile.displayName || handle} has no whimsy.</p>`;
                
                const uris = repoRes.data.records?.map((r: any) => r.value.subject.uri) || [];
                
                if (uris.length > 0) {
                    const hydratedRes = await bskyClient.get('app.bsky.feed.getPosts', 
                        { params: { uris } });
                    if(hydratedRes.ok)
                    {
                        const likedPosts: HTMLElement[] = hydratedRes.data.posts.map((post: any) => 
                            createPostElement(post, "Liked"));
                        if(likedPosts.length > 0)
                            feedLikes.replaceChildren(...likedPosts);
                    }
                }
            }
            // all api calls completed

            // show tabs, hide status
            statusEl?.classList.add('hidden');
            tabsContainer?.classList.remove('hidden');
            updateTabVisibility();

        } catch (err: any) {
            console.error(err);
            if (statusEl) statusEl.innerText = `Error: ${err.message || 'User not found.'}`;
        }
    }
    
    function updateTabVisibility() {
        if (currentTab === 'posts') {
            btnPosts?.classList.add('active');
            btnLikes?.classList.remove('active');
            feedPosts?.classList.remove('hidden');
            feedLikes?.classList.add('hidden');
        } else {
            btnLikes?.classList.add('active');
            btnPosts?.classList.remove('active');
            feedLikes?.classList.remove('hidden');
            feedPosts?.classList.add('hidden');
        }
    }
    
    // ON PAGE LOAD
    
    // add event listener
    searchBtn?.addEventListener('click', loadBlueskyFeed);
    input?.addEventListener('keydown', (e) => { if (e.key === 'Enter') loadBlueskyFeed(); });

    btnPosts?.addEventListener('click', () => { currentTab = 'posts'; updateTabVisibility(); });
    btnLikes?.addEventListener('click', () => { currentTab = 'likes'; updateTabVisibility(); });
    
    loadBlueskyFeed()
</script>

<style is:global>
    .bsky-container { display: flex; flex-direction: column; gap: 1.5rem; }

    .bsky-container .search-box { display: flex; gap: 10px; border: 0; }
    .bsky-container .search-box input {
        flex: 1;
        padding: 12px;
        background-color: var(--eg-surface-1);
        border: 0;
        color: var(--eg-foreground);
        font-size: 1rem;
    }
    .bsky-container .search-box input:focus {
        outline: 2px solid var(--eg-green);
        transition: outline 0.2s;
    }
    .bsky-container .search-box button {
        padding: 10px 20px;
        background-color: var(--eg-green);
        color: var(--eg-background);
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .bsky-container .search-box button:hover {
        background-color: var(--eg-foreground);
    }

    /* Status */
    .bsky-container .status-msg {
        background-color: var(--eg-surface-0);
        color: var(--eg-yellow);
        padding: 12px;
        text-align: center;
        font-weight: 500;
    }

    /* Profile */
    .bsky-container .profile-card {
        background-color: var(--eg-surface-0);
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: center;
    }
    .bsky-container .profile-card img {
        width: 70px; 
        height: 70px; 
        background: var(--eg-surface-1); 
        object-fit: cover;
        flex-shrink: 0;
        align-self: start;
    }
    .bsky-container .profile-info h2 { margin: 0; font-size: 1.3rem; color: var(--eg-green); }
    .bsky-container .profile-info #bsky-handle { color: var(--eg-green); }
    .bsky-container .profile-info #bsky-desc { color: var(--eg-foreground); }
    .bsky-container .profile-info #bsky-pds { color: var(--eg-purple); font-size: 0.8rem;}
    .bsky-container .profile-subinfo { display: flex; flex-direction: row; gap: 1rem; font-size: 0.8rem;}
    .bsky-container .profile-subinfo #bsky-pronouns { color: var(--eg-foreground); margin: 0 0;}
    .bsky-container .profile-subinfo #bsky-website { color: var(--eg-foreground); margin: 0 0;}
    .bsky-container .profile-subinfo #bsky-joined { color: var(--eg-foreground); margin: 0 0;}

    /* tabs navigation */
    .bsky-container .tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .bsky-container .tab-btn {
        padding: 10px;
        background-color: var(--eg-surface-0);
        color: var(--eg-purple);
        border: 0;
        font-weight: bold;
        cursor: pointer;
        text-align: center;
        font-size: 1rem;
        transition: all 0.2s;
    }
    .bsky-container .tab-btn.active {
        background-color: var(--eg-green);
        color: var(--eg-background);
        border-color: var(--eg-green);
    }

    /* Feeds Posts */
    .bsky-container .feed { display: flex; flex-direction: column; gap: 1rem; }
    .bsky-container .post {
        background-color: var(--eg-surface-0);
        padding: 1.25rem;
        border-left: 4px solid var(--eg-green);
    }

    .bsky-container .post-header {
        margin-bottom: 0.75rem;
    }

    .bsky-container .meta { font-size: 0.85rem; color: var(--eg-foreground); margin-bottom: 0.5rem; }
    .bsky-container .author-name { font-weight: 700; color: var(--eg-foreground); }
    .bsky-container .post-text { white-space: pre-wrap; margin: 0; line-height: 1.5; color: var(--eg-foreground); }
    .bsky-container .post.is-like { border-left-color: var(--eg-pink); }

    .bsky-container .post-time {
        font-size: 0.8rem;
        color: var(--eg-foreground);
        align-self: center;
    }

    .bsky-container .post-footer {
        margin-top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 4px dotted var(--eg-border);
        padding-top: 0.5rem;
    }

    .bsky-container .bsky-link {
        font-size: 0.85rem;
        color: var(--eg-purple);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

    .bsky-container .bsky-link:hover {
        color: var(--eg-green);
        text-decoration: underline;
    }
    
    /* other */

    .bsky-container .empty-msg {
        color: var(--eg-foreground);
        text-align: center;
        font-weight: 500;
    }

    .bsky-container .hidden { display: none !important; }
</style>
