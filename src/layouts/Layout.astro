---
const { title = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	/* evergarden scheme */
	:root {
		--eg-background: #232a2e;
		--eg-foreground: #f8f9e8;

		--eg-green: #cbe3b3;
		--eg-pink: #f3c0e5;
		--eg-purple: #d2bdf3;
		--eg-blue: #b2caed;
		--eg-yellow: #f5d098;

		--eg-surface-0: #2b3337;
		--eg-surface-1: #374145;
		--eg-border: #1c2225;
		--eg-muted: #171c1f;
	}
	
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
