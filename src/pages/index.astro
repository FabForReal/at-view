---
import Layout from '../layouts/Layout.astro';
import AstroFeed from "../components/AstroFeed.astro";
import MiniHeader from '../components/MiniHeader.astro';
---

<Layout title="at-view">
	<MiniHeader></MiniHeader>
	<AstroFeed></AstroFeed>
</Layout>

<style is:global>
	body {
		font-family: system-ui, -apple-system, sans-serif;
		background-color: var(--eg-background);
		color: var(--eg-foreground);
		max-width: 650px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	header h1 {
		text-align: center;
		margin-bottom: 2rem;
		color: var(--eg-green);
	}
	
	text {
		color: var(--eg-foreground);
	}
</style>